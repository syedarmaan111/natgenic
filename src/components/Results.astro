---
const RESULTS = ['/images/result-1.jpg', '/images/result-2.jpg', '/images/result-3.jpg', '/images/result-4.jpg'];
const REVIEWS = ['/images/review-1.jpg', '/images/review-2.jpg', '/images/review-3.jpg'];
---
<section id="results"><div class="wrap">
  <div class="center reveal"><p class="eyebrow">Real Results</p><h2 class="h-lg">Real People. Real Progress.</h2><div class="divider" style="margin-top:28px"></div><p class="lead">Don’t just take our word for it. See the results shared by real customers who followed the routine consistently.</p></div>
  <div class="results-grid">{RESULTS.map((image, index) => <article class="result reveal"><img class="result-image" src={image} alt={`Natgenic customer result ${index + 1}`} loading="lazy" /><div class="result-foot"><strong>Customer progress</strong><span>Before → After</span></div></article>)}</div>
  <div class="subhead-row reveal"><h3>In their own words.</h3><p>Messages shared by Natgenic customers.</p></div>
  <div class="review-grid">{REVIEWS.map((image, index) => <article class="review-card reveal"><img src={image} alt={`Written customer review ${index + 1}`} loading="lazy" /></article>)}</div>
  <p class="results-note">All photographs and messages are shared by Natgenic customers with their permission. Results vary from person to person and depend on consistency, individual hair type and underlying causes of hair loss.</p>
</div></section>
