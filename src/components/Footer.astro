---
import { INSTAGRAM_URL } from '../data/content';
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="wrap">
  <div class="footer-top"><div class="footer-brand"><img class="footer-logo" src="/images/natgenic-logo.jpg" alt="Natgenic" /><p class="name">Natgenic</p><p class="tag">Hair Care. Naturally Focused.</p><a class="ig-link" href={INSTAGRAM_URL} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></svg>@natgenic.in</a></div>
  <div class="footer-col"><h4>Explore</h4><ul><li><a href="/#product-intro">Meet Natgenic</a></li><li><a href="/#challenge">60-Day Challenge</a></li><li><a href="/#results">Real Results</a></li><li><a href="/#how-to-use">How to Use</a></li><li><a href="/#faq">FAQ</a></li></ul></div>
  <div class="footer-col"><h4>Contact</h4><ul><li><a href="mailto:natgenic.hairoil@gmail.com">natgenic.hairoil@gmail.com</a></li><li><a href={INSTAGRAM_URL} target="_blank" rel="noopener">Order on Instagram</a></li></ul></div></div>
  <div class="footer-bottom"><p>© <span>{year}</span> Natgenic. All rights reserved.</p><nav><a href="/terms">Terms</a><a href="/privacy-policy">Privacy Policy</a></nav></div>
  <p style="margin-top:24px;font-size:11.5px;line-height:1.7;color:rgba(255,255,255,.34);max-width:72ch">Natgenic is a cosmetic hair-care product and is not intended to diagnose, treat or cure any medical condition. Results vary between individuals. For persistent or sudden hair loss, please consult a qualified dermatologist.</p>
</div></footer>
